+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+package org.photonvision.common.hardware;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.stream.Stream;
+
+/** Detects a Google Coral USB Accelerator (Edge TPU). */
+public final class EdgeTpu {
+    private EdgeTpu() {}
+
+    /**
+     * USB vendor:product IDs of the Coral USB Accelerator. Before libedgetpu uploads firmware it
+     * enumerates as Global Unichip 1a6e:089a; afterwards as Google 18d1:9302.
+     */
+    private static final String[][] USB_IDS = {{"1a6e", "089a"}, {"18d1", "9302"}};
+
+    private static final Path USB_DEVICES = Path.of("/sys/bus/usb/devices");
+
+    private static Boolean cached = null;
+
+    /** Returns true if a Coral USB Accelerator is plugged in. Result is cached after first call. */
+    public static synchronized boolean isUsbCoralPresent() {
+        if (cached == null) {
+            cached = scan();
+        }
+        return cached;
+    }
+
+    private static boolean scan() {
+        if (!Platform.isLinux() || !Files.isDirectory(USB_DEVICES)) {
+            return false;
+        }
+
+        try (Stream<Path> devices = Files.list(USB_DEVICES)) {
+            return devices.anyMatch(EdgeTpu::isCoral);
+        } catch (IOException e) {
+            return false;
+        }
+    }
+
+    private static boolean isCoral(Path dev) {
+        String vendor = readId(dev.resolve("idVendor"));
+        String product = readId(dev.resolve("idProduct"));
+        if (vendor == null || product == null) {
+            return false;
+        }
+        for (String[] id : USB_IDS) {
+            if (id[0].equals(vendor) && id[1].equals(product)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static String readId(Path p) {
+        try {
+            return Files.readString(p).trim().toLowerCase();
+        } catch (IOException e) {
+            return null;
+        }
+    }
+}
