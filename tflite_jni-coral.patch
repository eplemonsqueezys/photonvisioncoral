+
+std::vector<DetectResult> ultralyticsPostProc(TfLiteInterpreter* interpreter,
+                                              double boxThresh,
+                                              double nmsThreshold,
+                                              int input_img_width,
+                                              int input_img_height) {
+  const TfLiteTensor* out = TfLiteInterpreterGetOutputTensor(interpreter, 0);
+  if (!out || TfLiteTensorNumDims(out) != 3) {
+    throw std::runtime_error(
+        "Expected a single output tensor of shape [1, 4 + classes, boxes]");
+  }
+
+  const int d1 = TfLiteTensorDim(out, 1);
+  const int d2 = TfLiteTensorDim(out, 2);
+  // The smaller dimension is the per-box channel dimension (4 + classes).
+  const bool channelsFirst = d1 < d2;
+  const int channels = channelsFirst ? d1 : d2;
+  const int numBoxes = channelsFirst ? d2 : d1;
+  const int numClasses = channels - 4;
+  if (numClasses < 1) {
+    throw std::runtime_error("Output tensor has too few channels for YOLO");
+  }
+
+  const TfLiteType type = TfLiteTensorType(out);
+  if (type != kTfLiteUInt8 && type != kTfLiteInt8 && type != kTfLiteFloat32) {
+    throw std::runtime_error("Unsupported output tensor type");
+  }
+  const TfLiteQuantizationParams qp = TfLiteTensorQuantizationParams(out);
+  void* data = TfLiteTensorData(out);
+
+  auto at = [&](int box, int ch) -> float {
+    const int idx = channelsFirst ? ch * numBoxes + box : box * channels + ch;
+    return get_dequant_value(data, type, idx, qp.zero_point, qp.scale);
+  };
+
+  struct Candidate {
+    float cx, cy, w, h, score;
+    int classId;
+  };
+  std::vector<Candidate> raw;
+  float maxCoord = 0.0f;
+
+  for (int i = 0; i < numBoxes; ++i) {
+    int bestClass = 0;
+    float best = at(i, 4);
+    for (int c = 1; c < numClasses; ++c) {
+      const float v = at(i, 4 + c);
+      if (v > best) {
+        best = v;
+        bestClass = c;
+      }
+    }
+    if (best < boxThresh) continue;
+
+    Candidate cand{at(i, 0), at(i, 1), at(i, 2), at(i, 3), best, bestClass};
+    maxCoord = std::max({maxCoord, cand.cx, cand.cy, cand.w, cand.h});
+    raw.push_back(cand);
+  }
+
+  // Ultralytics TFLite exports emit normalized coordinates; scale to pixels.
+  const bool normalized = maxCoord <= 2.0f;
+  const float sx = normalized ? static_cast<float>(input_img_width) : 1.0f;
+  const float sy = normalized ? static_cast<float>(input_img_height) : 1.0f;
+
+  std::vector<DetectResult> candidates;
+  candidates.reserve(raw.size());
+  for (const auto& c : raw) {
+    float x1 = (c.cx - c.w / 2.0f) * sx;
+    float y1 = (c.cy - c.h / 2.0f) * sy;
+    float x2 = (c.cx + c.w / 2.0f) * sx;
+    float y2 = (c.cy + c.h / 2.0f) * sy;
+
+    x1 = std::max(0.0f, std::min(x1, static_cast<float>(input_img_width)));
+    y1 = std::max(0.0f, std::min(y1, static_cast<float>(input_img_height)));
+    x2 = std::max(0.0f, std::min(x2, static_cast<float>(input_img_width)));
+    y2 = std::max(0.0f, std::min(y2, static_cast<float>(input_img_height)));
+    if (x1 >= x2 || y1 >= y2) continue;
+
+    BoundingBox box{static_cast<int>(std::round(x1)),
+                    static_cast<int>(std::round(y1)),
+                    static_cast<int>(std::round(x2)),
+                    static_cast<int>(std::round(y2)), 0.0};
+    candidates.push_back(DetectResult{c.classId, box, c.score});
+  }
+
+  DEBUG_PRINT("INFO: Ultralytics postproc kept %zu candidates (normalized=%d)\n",
+              candidates.size(), normalized ? 1 : 0);
+
+  return optimizedNMS(candidates, static_cast<float>(nmsThreshold));
+}
