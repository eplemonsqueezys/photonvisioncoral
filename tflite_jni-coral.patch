+/**
+ * Post-processing for Ultralytics TFLite / Edge TPU exports, which have a
+ * single output tensor shaped [1, 4 + num_classes, num_boxes] (or the
+ * transposed [1, num_boxes, 4 + num_classes]). Boxes are center-x, center-y,
+ * width, height and may be normalized to [0, 1] or in pixels. Handles uint8,
+ * int8 and float32 outputs.
+ */
+std::vector<DetectResult> ultralyticsPostProc(TfLiteInterpreter* interpreter,
+                                              double boxThresh,
+                                              double nmsThreshold,
+                                              int input_img_width,
+                                              int input_img_height);
